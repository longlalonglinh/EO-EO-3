+        const sanitizeQs = (qs: any[], prefix: string) => {
+          const seen = new Set<string>();
+          return qs.map((q, idx) => {
+            let qid = q.question_id || `${prefix}${idx + 1}`;
+            if (seen.has(qid)) {
+              qid = `${qid}_dup_${idx}`;
+            }
+            seen.add(qid);
+            return { ...q, question_id: qid };
+          });
+        };
